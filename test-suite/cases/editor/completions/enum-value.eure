// Test: enum value completion
// From: crates/eure-editor-support/tests/completions_test.rs:test_enum_value_completion
// Completion of literal values for a union of literals

schema = ```eure
config {
  environment {
    $variant: union
    variants.development = "development"
    variants.staging = "staging"
    variants.production = "production"
  }
  log_level {
    $variant: union
    variants.debug = "debug"
    variants.info = "info"
    variants.warn = "warn"
    variants.error = "error"
    variants.fatal = "fatal"
  }
  port = `integer`
}
```

editor = ```eure
@ config
environment = |_|
```

trigger = "="

@ completions[]
label = "\"development\""
kind = "value"

@ completions[]
label = "\"staging\""
kind = "value"

@ completions[]
label = "\"production\""
kind = "value"
