// Test: completion after dot
// From: crates/eure-editor-support/tests/completion_basic_test.rs:test_completion_after_dot

schema = ```eure
script {
  name = `text`
  version = `text`
}
```

editor = ```eure
@ script.|_|
```

trigger = "."

// Should suggest keys that can follow script

@ completions[]
label = "name"
kind = "field"

@ completions[]
label = "version"
kind = "field"
