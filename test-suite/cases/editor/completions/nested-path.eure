// Test: nested path completion
// From: crates/eure-editor-support/tests/completions_test.rs:test_nested_path_completion
// Completion for nested paths like user.address.

schema = ```eure
user {
  address {
    street = `text`
    city = `text`
    zipcode = `text`
    country = `text`
    country.$optional = true
  }
  name = `text`
}
```

editor = ```eure
user.address.|_|
```

trigger = "."

// Should only show the 4 fields from the address schema

@ completions[]
label = "street"
kind = "field"

@ completions[]
label = "city"
kind = "field"

@ completions[]
label = "zipcode"
kind = "field"

@ completions[]
label = "country"
kind = "field"
