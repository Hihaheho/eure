// Test: mixed path completion
// From: crates/eure-editor-support/tests/completions_test.rs:test_mixed_path_completion
// Completion for complex paths like config.servers[].

schema = ```eure
$types.Server {
  host = `text`
  port = `integer`
  protocol {
    $variant: union
    variants.http = "http"
    variants.https = "https"
    variants.ws = "ws"
    variants.wss = "wss"
  }
  enabled = `boolean`
  enabled.$default = true
}

config {
  servers = [`$types.Server`]
}
```

editor = ```eure
@ config.servers[]
|_|
```

// Should have server fields: host, port, protocol, enabled

@ completions[]
label = "host"
kind = "field"

@ completions[]
label = "port"
kind = "field"

@ completions[]
label = "protocol"
kind = "field"

@ completions[]
label = "enabled"
kind = "field"
