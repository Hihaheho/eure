unimplemented = "type reference completion inside inline code is not implemented"

// Test: type reference completion
// From: crates/eure-editor-support/tests/completions_test.rs:test_type_reference_completion
// Completion of type names inside a `$types.` reference in a schema document

editor = ```eure
$types.Person {
  name = `text`
  age = `integer`
}

$types.Address {
  street = `text`
  city = `text`
  country = `text`
}

$types.Company {
  name = `text`
  employees = [`$types.Person`]
  headquarters = `$types.Address`
}

user = `$types.|_|`
```

trigger = "."

// Should have type names: Person, Address, Company

@ completions[]
label = "Person"
kind = "type"

@ completions[]
label = "Address"
kind = "type"

@ completions[]
label = "Company"
kind = "type"
