// Test: completion in nested section should suggest nested fields
// From: crates/eure-editor-support/tests/completion_nested_context_test.rs:test_completion_in_nested_section_should_suggest_nested_fields

schema = ```eure
script = `text`
name = `text`
database {
  host = `text`
  port = `integer`
  credentials {
    username = `text`
    password = `text`
    api_key = `text`
  }
}
logging {
  level = `text`
  file = `text`
}
```

editor = ```eure
@ database.credentials
username = "admin"
|_|
```

// SHOULD suggest fields from database.credentials context
// SHOULD NOT suggest root-level fields, parent fields, or already used fields
@ completions[]
label = "password"
kind = "field"

@ completions[]
label = "api_key"
kind = "field"
