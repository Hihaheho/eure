// Schema with $types definitions; only the document fields are offered

schema = ```eure
$types.Person {
  name = `text`
  age = `integer`
}

user = `$types.Person`
```

editor = ```eure
@|_|
```

trigger = "@"

@ completions[]
label = "user"
kind = "field"
