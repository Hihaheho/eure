// Test: partial key completion
// From: crates/eure-editor-support/tests/completion_basic_test.rs:test_partial_key_completion

schema = ```eure
script = `text`
screen = `integer`
settings = `any`
```

editor = ```eure
@ scr|_|
```

// Should suggest keys starting with "scr"
// Should not suggest 'settings' (doesn't start with 'scr')

@ completions[]
label = "script"
kind = "field"

@ completions[]
label = "screen"
kind = "field"
