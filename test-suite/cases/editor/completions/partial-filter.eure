// Test: partial completion filters correctly
// From: crates/eure-editor-support/tests/completion_multiple_fields_test.rs:test_partial_completion_filters_correctly

schema = ```eure
script = `text`
screen = `text`
settings = `any`
users = [`any`]
```

editor = ```eure
@ scr|_|
```

// Should only suggest fields starting with "scr"

@ completions[]
label = "script"
kind = "field"

@ completions[]
label = "screen"
kind = "field"
