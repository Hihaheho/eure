// Test: completion with inline objects
// From: crates/eure-editor-support/tests/completions_test.rs:test_completion_with_inline_objects
// Completion inside inline object syntax { key => value, ... }

schema = ```eure
user {
  name = `text`
  age = `integer`
  email = `text`
}
```

editor = ```eure
user = { name => "Alice", |_| }
```

// Should suggest remaining fields (age, email) but not already-used field (name)
@ completions[]
label = "age"
kind = "field"

@ completions[]
label = "email"
kind = "field"
