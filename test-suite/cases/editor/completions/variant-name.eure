// Test: variant name completion
// From: crates/eure-editor-support/tests/completions_test.rs:test_variant_name_completion
// Completion of variant names after $variant:

schema = ```eure
$types.Action {
  $variant: union
  variants.set-text {
    speaker = `text`
    lines = [`text`]
  }
  variants.set-choices {
    description = `text`
    choices = [`$types.Choice`]
  }
  variants.navigate {
    target = `text`
    mode {
      $variant: union
      variants.push = "push"
      variants.replace = "replace"
      variants.pop = "pop"
    }
  }
}

$types.Choice {
  text = `text`
  value = `text`
}

actions = [`$types.Action`]
```

editor = ```eure
@ actions[]
$variant: |_|
```

trigger = ":"

// Should have variant names: set-text, set-choices, navigate

@ completions[]
label = "set-text"
kind = "variant"

@ completions[]
label = "set-choices"
kind = "variant"

@ completions[]
label = "navigate"
kind = "variant"
