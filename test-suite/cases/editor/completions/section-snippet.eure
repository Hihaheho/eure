// Test: completion of record-valued fields
// From: crates/eure-editor-support/tests/completions_test.rs:test_section_snippet_generation

schema = ```eure
user {
  name {
    first = `text`
    last = `text`
    middle = `text`
    middle.$optional = true
  }
  age = `integer`
}
```

editor = ```eure
user.|_|
```

trigger = "."

@ completions[]
label = "name"
kind = "field"

@ completions[]
label = "age"
kind = "field"
