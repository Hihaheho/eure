// Test: variant field completion (set-text)
// From: crates/eure-editor-support/tests/completions_test.rs:test_variant_field_completion
// Completion of fields specific to selected variant

schema = ```eure
$types.Action {
  $variant: union
  variants.set-text {
    speaker = `text`
    lines = [`text`]
  }
  variants.set-choices {
    description = `text`
    choices = [`$types.Choice`]
  }
}

$types.Choice {
  text = `text`
  value = `text`
}

actions = [`$types.Action`]
```

editor = ```eure
@ actions[]
$variant: set-text
|_|
```

// Should have set-text variant fields: speaker, lines
// Should NOT have fields from other variants: description, choices

@ completions[]
label = "speaker"
kind = "field"

@ completions[]
label = "lines"
kind = "field"
