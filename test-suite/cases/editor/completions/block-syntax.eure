// Completions inside block syntax { ... }

schema = ```eure
user {
  name = `text`
  email = `text`
  profile {
    bio = `text`
    avatar_url = `text`
    avatar_url.$optional = true
  }
}
```

editor = ```eure
@ user {
    |_|
}
```

// Should have user fields: name, email, profile

@ completions[]
label = "name"
kind = "field"

@ completions[]
label = "email"
kind = "field"

@ completions[]
