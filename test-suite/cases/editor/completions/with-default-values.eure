// Test: completion with default values
// From: crates/eure-editor-support/tests/completions_test.rs:test_completion_with_default_values
// Fields with default values are offered like any other field

schema = ```eure
database {
  host = `text`
  host.$default = "localhost"
  port = `integer`
  port.$default = 5432
  ssl_enabled = `boolean`
  ssl_enabled.$default = true
  connection_timeout = `integer`
  connection_timeout.$default = 30
  connection_timeout.$optional = true
}
```

editor = ```eure
