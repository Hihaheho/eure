// Test: completion in deeply nested array element
// From: crates/eure-editor-support/tests/completion_nested_context_test.rs:test_completion_in_deeply_nested_array_element

schema = ```eure
$types.Role {
  role_name = `text`
  permissions = [`text`]
  metadata {
    created_at = `text`
    expires_at = `text`
  }
}

$types.User {
  name = `text`
  email = `text`
  roles = [`$types.Role`]
}

users = [`$types.User`]
settings {
  theme = `text`
}
```

editor = ```eure
@ users[]
name = "Alice"

@ users[].roles[]
role_name = "admin"

@ users[].roles[].metadata
created_at = "2024-01-01"
|_|
```

// SHOULD suggest the remaining field from roles[].metadata context only
@ completions[]
label = "expires_at"
kind = "field"
