// Test: completion in nested block with arrays
// From: crates/eure-editor-support/tests/completions_test.rs:test_completion_in_nested_block_with_arrays
// Complex nesting: blocks containing arrays containing blocks

schema = ```eure
$types.Endpoint {
  path = `text`
  method {
    $variant: union
    variants.get = "GET"
    variants.post = "POST"
    variants.put = "PUT"
    variants.delete = "DELETE"
  }
}

$types.Server {
  name = `text`
  endpoints = [`$types.Endpoint`]
}

config {
  servers = [`$types.Server`]
}
```

editor = ```eure
@ config {
    @ servers[] {
        |_|
    }
}
```

// Should have server array element fields: name, endpoints

@ completions[]
label = "name"
kind = "field"

@ completions[]
label = "endpoints"
kind = "field"
