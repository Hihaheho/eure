// Test: completion with cascading type
// From: crates/eure-editor-support/tests/completions_test.rs:test_completion_with_cascading_type
// Array element type is applied to each element section

schema = ```eure
$types.Server {
  name = `text`
  host = `text`
  port = `integer`
  port.$default = 8080
}

servers = [`$types.Server`]
```

editor = ```eure
@ servers[]
|_|
```

// Should have array element fields: name, host, port

@ completions[]
label = "name"
kind = "field"

@ completions[]
label = "host"
kind = "field"

@ completions[]
label = "port"
kind = "field"
