// Test: completion with partial syntax
// From: crates/eure-editor-support/tests/completions_test.rs:test_completion_with_partial_syntax
// Completion when the document has syntax errors or is incomplete

schema = ```eure
user {
  name = `text`
  email = `text`
  employee_id = `integer`
}
```

editor = ```eure
@ user
name = "Alice"
em|_|
```

// Should provide completions that match the prefix "em"
@ completions[]
label = "email"
kind = "field"

@ completions[]
label = "employee_id"
kind = "field"
