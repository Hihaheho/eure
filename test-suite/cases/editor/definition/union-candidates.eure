// An untagged union field returns both candidates in order.

schema = ```eure
$types.action {
  $variant: union
  variants.say { line = `text` }
  variants.shout { line = `text` }
}
actions = [`$types.action`]
```

editor = ```eure
@ actions[] {
  li|_|ne = "hi"
}
```

